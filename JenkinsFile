pipeline {
   agent { label 'slave1' } 
    stages {
        stage('checkout') {
            steps {
              sh "rm -rf news-app-devops "
                sh "git clone https://github.com/ManasaMarigowda/news-app-devops"
            }
  }
        stage('build') {
            steps {
    
                sh "mvn clean package"
            }
}
   stage('Depoly') {
           steps {
        sh "rm -rf /home/ubuntu/workspace/news-app-devops_feature-1/target/news-app.war"
           sh "sudo cp /home/ubuntu/workspace/news-app-devops_feature-1/target/news-app.war /opt/tomcat10/webapps"
       }
    }
}
}
