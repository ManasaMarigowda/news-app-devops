pipeline {
environment {
    JFROG_URL = 'https://trialcxid14.jfrog.io/artifactory/api/maven/news-app-devops-libs-snapshot'
    REPO_NAME = 'news-app-devops-libs-snapshot'      // JFrog repo for feature branches
  }
agent { label 'slave1' } 
    stages {
        stage('checkout') {
            steps {
              sh "rm -rf news-app-devops "
                sh "git clone https://github.com/ManasaMarigowda/news-app-devops"
            }
  }
        stage('build') {
            steps {
    
                sh "mvn clean package"
            }
}
stage('Upload to JFrog') {
      steps {
        withCredentials([string(credentialsId: 'jfrogkey', variable: 'JFROG_API_KEY')]) {
          sh """
            curl -f -H "X-JFrog-Art-Api: ${JFROG_API_KEY}"
                -T "$/home/ubuntu/workspace/news-app-devops_feature-2/target/news-app.war"
                ${JFROG_URL}/feature-2/news-app_1.war 
          """
        }
      }
    }
stage('Depoly') {
          steps {
           sh " rm-rf /home/ubuntu/workspace/news-app-devops_feature-2/target/news-app.war"
         
sh "sudo cp  /home/ubuntu/workspace/news-app-devops_feature-2/target/news-app.war /opt/tomcat10/webapps"
       }
  }
}
}
