pipeline {
environment {
    JFROG_URL = 'https://trialcxid14.jfrog.io/artifactory'
    REPO_NAME = 'news-app-devops-libs-snapshot'      // JFrog repo for feature branches
	 
  }
    agent { label 'slave1' }
    stages {
        stage('Checkout') {
            steps {
                 sh "rm -rf news-app-devops "
               sh "git clone https://github.com/ManasaMarigowda/news-app-devops"
            }
        } 
 

      // stage('Create Versioned Artifact') {
      //steps {
       // script {
      //def sha = sh(
      //     script: 'git rev-parse --short HEAD',
        //    returnStdout: true
        //  ).trim()

          //def branchSafe = env.BRANCH_NAME.replaceAll('[^a-zA-Z0-9_.-]', '_')

          env.ARTIFACT1 = "news-app-feature1-${env.BUILD_NUMBER}-${sha}.war"
		  env.ARTIFACT1 = "news-app-feature2-${env.BUILD_NUMBER}-${sha}.war"

          sh "cp /home/ubuntu/workspace/news-app-devops_feature-1/target/*.war ${env.ARTIFACT1}"
          sh "cp /home/ubuntu/workspace/news-app-devops_feature-2/target/*.war ${env.ARTIFACT2}"
          archiveArtifacts artifacts: "${env.ARTIFACT1}","${env.ARTIFACT2}", fingerprint: true
        }
      }
    }

    stage('Upload to JFrog') {
      steps {
        withCredentials([string(credentialsId: 'jfrogkey', variable: 'JFROG_API_KEY')]) {
          sh """
            curl -f -H "X-JFrog-Art-Api: ${JFROG_API_KEY}" \
                -T "${env.ARTIFACT1}" \
                "${JFROG_URL}/${REPO_NAME}/feature-1/${env.ARTIFACT1}" 
          """
        }
      }
    }
       

   

}

}
